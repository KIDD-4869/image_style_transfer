# 应用配置示例
# 复制此文件为 .env 并根据需要修改

# 应用基本配置
DEBUG=false
HOST=0.0.0.0
PORT=5003

# 上传配置
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=20971520  # 20MB in bytes
MAX_IMAGE_SIZE=2048

# 处理配置
MAX_CONCURRENT_TASKS=3
DEFAULT_STRATEGY=balanced

# 任务管理配置
TASK_MAX_TASKS=100
TASK_TTL_HOURS=24

# 缓存配置
CACHE_ENABLED=true
CACHE_MEMORY_SIZE=100  # MB
CACHE_DISK_SIZE=1000   # MB
CACHE_DIR=./cache
CACHE_TTL_HOURS=24
CACHE_ENABLE_DISK=true
